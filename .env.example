# Required: your Gemini API key (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the default model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Required for accounts/usage tracking (LICENSING.md Part 1): your Neon
# Postgres connection string. Use the POOLED connection string (hostname
# contains "-pooler") from the Neon dashboard, not the direct one.
DATABASE_URL=

# Required: signs sessions/tokens. Generate with `npx @better-auth/cli secret`.
# Use a different value per environment — never share the dev secret with production.
BETTER_AUTH_SECRET=

# Required: the app's own public URL, used for auth callbacks/redirects.
# http://localhost:3000 in dev; your real deployed URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Not used yet. Google sign-in is a disabled "coming soon" placeholder
# in the UI right now (src/components/GoogleSignInButton.tsx) — setting
# these does nothing until that button is wired to a real sign-in call,
# which is its own separate, not-yet-scheduled task. Left here as a
# forward reference for when that happens:
#
# Create credentials at https://console.cloud.google.com/apis/credentials
# ("Create Credentials" -> "OAuth client ID" -> "Web application"). Add
# BOTH of these under "Authorized redirect URIs" (Better Auth's fixed
# callback path — do not change the path, only the host per environment):
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
# The Client ID is not secret; the Client Secret is — set it directly in
# your deploy host's environment variables, never commit it here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
