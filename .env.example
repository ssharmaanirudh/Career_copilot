# Required: your Gemini API key (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the default model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Required for accounts/usage tracking (LICENSING.md Part 1): your Neon
# Postgres connection string. Use the POOLED connection string (hostname
# contains "-pooler") from the Neon dashboard, not the direct one.
DATABASE_URL=

# Required: signs sessions/tokens. Generate with `npx @better-auth/cli secret`.
# Use a different value per environment — never share the dev secret with production.
BETTER_AUTH_SECRET=

# Required: the app's own public URL, used for auth callbacks/redirects.
# http://localhost:3000 in dev; your real deployed URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Optional: enables Google sign-in. Leave both unset to offer email/password only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
